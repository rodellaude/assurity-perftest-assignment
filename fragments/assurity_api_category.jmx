          <hashTree>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Category - JSR223 Assertion">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

// 1. Response Status Assertion
def responseCode = prev.getResponseCode().toString()
if (responseCode != &quot;200&quot;) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Assertion Failed: Response status code is &quot; + responseCode)
    return
}

String responseStr = prev.getResponseDataAsString()

// Parse JSON response
def jsonSlurper = new JsonSlurper()
def jsonResponse
try {
    jsonResponse = jsonSlurper.parseText(responseStr)
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Assertion Failed: Unable to parse JSON response - &quot; + e.getMessage())
    return
}

// 2. Cascading Category ID Check (Missing field -&gt; Value match)
def rawCatId = jsonResponse.CategoryId ?: jsonResponse.Id
if (rawCatId == null) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Assertion Failed: &apos;CategoryId&apos; field is missing from the response.&quot;)
    return
} else {
    String expectedCatId = vars.get(&quot;param_category_id&quot;)
    if (expectedCatId != null &amp;&amp; !expectedCatId.isEmpty()) {
        String actualCatId = rawCatId.toString()
        if (actualCatId != expectedCatId) {
            AssertionResult.setFailure(true)
            AssertionResult.setFailureMessage(&quot;Assertion Failed: Category ID mismatch. Expected: ${expectedCatId}, Actual: ${actualCatId}&quot;)
            return
        }
    }
}

// 3. Cascading CanRelist Check (Missing field -&gt; Value true check)
if (jsonResponse.CanRelist == null) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Assertion Failed: &apos;CanRelist&apos; field is missing from the response.&quot;)
    return
} else {
    if (jsonResponse.CanRelist != true) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&quot;Assertion Failed: &apos;CanRelist&apos; value is not true.&quot;)
        return
    }
}

// 4. Extract Data and Write to CSV
String categoryId = rawCatId.toString()
String name = jsonResponse.Name?.toString() ?: &quot;N/A&quot;
String path = jsonResponse.Path?.toString() ?: &quot;N/A&quot;

// Handle promotions (if the API returns a list of promotions with IDs and prices)
def promotions = jsonResponse.Promotions ?: []

// Define CSV File path (saved in JMeter&apos;s current working directory or absolute path)
String csvFilePath = &quot;performance_test_results.csv&quot;
File csvFile = new File(csvFilePath)

synchronized(this) {
    // If file doesn&apos;t exist, write the header
    if (!csvFile.exists()) {
        csvFile.text = &quot;Category ID,Name,Path,Promotion ID,Price\n&quot;
    }

    // Append rows (if there are promotions, write one row per promotion; otherwise write one row with N/A promotion details)
    if (promotions.size() &gt; 0) {
        promotions.each { promo -&gt;
            String promoId = promo.Id?.toString() ?: &quot;N/A&quot;
            String price = promo.Price?.toString() ?: &quot;N/A&quot;
            csvFile.append(&quot;\&quot;${categoryId}\&quot;,\&quot;${name}\&quot;,\&quot;${path}\&quot;,\&quot;${promoId}\&quot;,\&quot;${price}\&quot;\n&quot;)
        }
    } else {
        csvFile.append(&quot;\&quot;${categoryId}\&quot;,\&quot;${name}\&quot;,\&quot;${path}\&quot;,\&quot;N/A\&quot;,\&quot;N/A\&quot;\n&quot;)
    }
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
