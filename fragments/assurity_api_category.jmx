        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Category - HTTP Request" enabled="true">
            <stringProp name="HTTPSampler.domain">${host_tmsandbox}</stringProp>
            <stringProp name="HTTPSampler.protocol">${scheme_tmsandbox}</stringProp>
            <stringProp name="HTTPSampler.path">/v1/Categories/${param_category_id}/Details.json?catalogue=false</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Category - JSR223 Assertion" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import org.apache.jmeter.services.FileServer
import java.text.SimpleDateFormat

// 1. Response Status Assertion
def responseCode = prev.getResponseCode().toString()
if (responseCode != &quot;200&quot;) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Assertion Failed: Response status code is &quot; + responseCode)
    return
}

String responseStr = prev.getResponseDataAsString()

// Parse JSON response
def jsonSlurper = new JsonSlurper()
def jsonResponse
try {
    jsonResponse = jsonSlurper.parseText(responseStr)
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Assertion Failed: Unable to parse JSON response - &quot; + e.getMessage())
    return
}

// 2. Category ID Check
def rawCatId = jsonResponse.CategoryId ?: jsonResponse.Id

if (rawCatId == null) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Assertion Failed: &apos;CategoryId&apos; field is missing from the response for &quot; + vars.get(&quot;param_category_id&quot;))
    return
} else {
    String expectedCatId = vars.get(&quot;param_category_id&quot;)
    if (expectedCatId != null &amp;&amp; !expectedCatId.isEmpty()) {
        String actualCatId = rawCatId.toString()
        if (actualCatId != expectedCatId) {
            AssertionResult.setFailure(true)
            AssertionResult.setFailureMessage(&quot;Assertion Failed: Category ID mismatch. Expected: ${expectedCatId}, Actual: ${actualCatId}&quot;)
            return
        }
    }
}

// 3. CanRelist Check
if (jsonResponse.CanRelist == null) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Assertion Failed: &apos;CanRelist&apos; field is missing from the response for &quot; + vars.get(&quot;param_category_id&quot;))
    return
} else {
    if (jsonResponse.CanRelist != true) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&quot;Assertion Failed: &apos;CanRelist&apos; value is not true for &quot; + vars.get(&quot;param_category_id&quot;))
        return
    }
}

// 4. Extract Data and Write to CSV (only when running in the &quot;main&quot; script)
String threadGroupName = ctx.getThreadGroup()?.getName() ?: vars.get(&quot;__threadGroupName&quot;)?.toString() ?: &quot;&quot;

if (threadGroupName != &quot;Debug&quot;) {
    String categoryId = rawCatId.toString()
    String name = (jsonResponse.Name?.toString() ?: &quot;N/A&quot;).replace(&quot;,&quot;, &quot; &quot;)
    String path = (jsonResponse.Path?.toString() ?: &quot;N/A&quot;).replace(&quot;,&quot;, &quot; &quot;)
    def promotions = jsonResponse.Promotions ?: []

    // Resolve .../assurity-perftest-assignment/logs from the executing script&apos;s base directory
    String baseDir = FileServer.getFileServer().getBaseDir()
    File logDir = new File(baseDir, &quot;logs&quot;)
    if (!logDir.exists()) {
        logDir.mkdirs()
    }

    // Use JMeter&apos;s TESTSTART.MS property for consistent run-start timestamp suffix
    String testStartStr = props.get(&quot;TESTSTART.MS&quot;)

    long testStartMs
    try {
        testStartMs = (testStartStr != null &amp;&amp; testStartStr.isLong()) ? testStartStr.toLong() : System.currentTimeMillis()
    } catch (Exception e) {
        testStartMs = System.currentTimeMillis()
    }

    String runStartStamp = new SimpleDateFormat(&quot;yyyyMMdd_HHmmss&quot;).format(new Date(testStartMs))

    File csvFile = new File(logDir, &quot;assurity_api_category_log_${runStartStamp}.csv&quot;)
    String csvFilePath = csvFile.getAbsolutePath()

    synchronized(csvFilePath.intern()) {
        if (!csvFile.exists()) {
            csvFile.text = &quot;Category ID,Name,Path,Promotion ID,Price\n&quot;
        }

        if (promotions.size() &gt; 0) {
            promotions.each { promo -&gt;
                String promoId = promo.Id?.toString() ?: &quot;N/A&quot;
                String price = promo.Price?.toString() ?: &quot;N/A&quot;
                csvFile.append(&quot;${categoryId},${name},${path},${promoId},${price}\n&quot;)
            }
        } else {
            csvFile.append(&quot;${categoryId},${name},${path},N/A,N/A\n&quot;)
        }
    }
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
